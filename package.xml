<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>septentrio_ros_node</name>
  <version>0.0.0</version>
  <description>  
  Package to parse NMEA strings from Serial input and publish a very simple GPS message.
  Does not require the GPSD deamon to be installed.
  Converted to work with the Septentrio RTK GPS units.
  </description>
  <maintainer email="srijal@umd.edu">srijal</maintainer>
  <license>BSD</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nmea_msgs</depend>
  <depend>sensor_msgs</depend>


  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
